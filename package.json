{
  "name": "gold-ai",
  "private": true,
  "version": "1.0.0",
  "description": "GOLD AI - Advanced Desktop Assistant",
  "author": "Jitendra Mishra",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "build:backend": "powershell -Command \"backend\\venv\\Scripts\\pyinstaller.exe --noconfirm --name backend --onedir --clean --hidden-import uvicorn --hidden-import uvicorn.logging --hidden-import uvicorn.loops --hidden-import uvicorn.loops.auto --hidden-import uvicorn.protocols --hidden-import uvicorn.protocols.http --hidden-import uvicorn.protocols.http.auto --hidden-import uvicorn.protocols.websockets --hidden-import uvicorn.protocols.websockets.auto --hidden-import uvicorn.lifespan --hidden-import uvicorn.lifespan.on --distpath dist-backend --workpath build-backend backend/server.py; Copy-Item backend\\.env dist-backend\\backend\\.env -Force\"",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.gold.ai",
    "productName": "GOLD AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-backend/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GOLD AI",
      "artifactName": "GOLD-AI-Setup.exe"
    },
    "portable": {
      "artifactName": "GOLD-AI-Portable.exe"
    }
  },
  "dependencies": {
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
